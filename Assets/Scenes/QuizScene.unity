  correctSprite: {fileID: 5755048524817218011, guid: 965b14d60d3a245a4a764d826170f968, type: 3}
  incorrectSprite: {fileID: 448634621944732350, guid: f111ae9af361642129f3e1b12c34c74f, type: 3}
  statusImage: {fileID: 690062061}
  maxTiltAngle: 30
  tiltSmoothSpeed: 10
  questionsJapanese:
  - navigationText: "\u8D64\u30EC\u30F3\u30AC\u3092\u5916\u304B\u3089\u89B3\u5BDF\u3057\u3066\u307F\u3088\u3046\uFF01"
    mapSprite: {fileID: 7629668518932357394, guid: 25bc532367b344f4897c35ddd7b7ea28, type: 3}
    questionText: "\u8D64\u30EC\u30F3\u30AC\u5EFA\u7269\u306E\u5357\u6771\u5074\u306E\u58C1\u306B\u898B\u3089\u308C\u308B\u3001\u6728\u67A0\u3068\u30EC\u30F3\u30AC\u3092\u7D44\u307F\u5408\u308F\u305B\u305F\u7279\u5FB4\u7684\u306A\u69CB\u9020\u306F\u4F55\uFF1F "
    optionLeft: "\u30CF\u30FC\u30D5\u30C6\u30A3\u30FC\u30F3\u30D0\u30FC\u69CB\u9020"
    optionRight: "\u7D44\u7A4D\u9020\uFF08\u305D\u305B\u304D\u305E\u3046\uFF09"
    optionLeftImage: {fileID: 5017201974510294690, guid: d107d599097074bf89d63b63248de70a, type: 3}
    optionRightImage: {fileID: -4131641259849213738, guid: a5bcb4dec10184137955c67b053ec1c4, type: 3}
    isLeftCorrect: 1
  - navigationText: "\u9577\u3044\u5ECA\u4E0B\u3067\u968E\u6BB5\u3092\u63A2\u3057\u3066\u307F\u3088\u3046\uFF01"
    mapSprite: {fileID: -1969723965258880426, guid: 4878ca3cfb6c74e4ea91a41da1d163b6, type: 3}
    questionText: "\u5275\u5EFA\u5F53\u521D\u304B\u3089\u3042\u308B\uFF15\u968E\u5EFA\u3066\u306E\u5854\u5C4B\u6700\u4E0A\u968E\u307E\u3067\u7D9A\u3044\u3066\u3044\u308B\u968E\u6BB5\u306F\u3001\u4F55\u3067\u4F5C\u3089\u308C\u3066\u305F\uFF1F"
    optionLeft: "\u30EC\u30F3\u30AC\u88FD\u968E\u6BB5"
    optionRight: "\u6728\u88FD\u968E\u6BB5"
    optionLeftImage: {fileID: -831103238611958488, guid: 555b8feb7998b40e3ab44591ac07e29f, type: 3}
    optionRightImage: {fileID: -7746288438476101081, guid: 70f18a05e154746b1959ff087126d349, type: 3}
    isLeftCorrect: 0
  - navigationText: "\u901A\u8DEF\u306E\u4E0A\u3092\u898B\u4E0A\u3052\u3066\u307F\u3088\u3046\uFF01"
    mapSprite: {fileID: -99259536455903762, guid: c8c63141ee5d94297af79343d0e550db, type: 3}
    questionText: "\u9AD8\u3044\u8010\u9707\u30FB\u8010\u706B\u30FB\u65AD\u71B1\u6027\u80FD\u3092\u6301\u305F\u305B\u308B\u305F\u3081\u306B\u3001\u5E8A\u306B\u63A1\u7528\u3055\u308C\u305F\u69CB\u9020\u306F\u3069\u308C\uFF1F"
    optionLeft: "\u30A2\u30FC\u30C1\u578B\u8010\u706B\u5E8A"
    optionRight: "\u683C\u5B50\u578B\u8010\u706B\u5E8A"
    optionLeftImage: {fileID: 6318451787307836473, guid: 010b3089481574d99b69b4d0f1ae303c, type: 3}
    optionRightImage: {fileID: 447541596860047045, guid: 3446a01f758144a70984d1f5c4358a1a, type: 3}
    isLeftCorrect: 1
  - navigationText: "\u30D1\u30B5\u30FC\u30B8\u30E5\u306E\u58C1\u3092\u89B3\u5BDF\u3057\u3066\u307F\u3088\u3046\uFF01"
    mapSprite: {fileID: -3954400287755740025, guid: 10f6de352a10b4c738e1f816090a8a07, type: 3}
    questionText: "\u30D3\u30FC\u30EB\u6A3D\u306E\u53CE\u307E\u308A\u3092\u3088\u304F\u3059\u308B\u305F\u3081\u3001\u30D1\u30B5\u30FC\u30B8\u30E5\u306E\u5185\u58C1\u306B\u65BD\u3055\u308C\u305F\u5DE5\u592B\u306F\u3069\u308C\uFF1F"
    optionLeft: "\u56DB\u89D2\u3044\u5207\u308A\u6B20\u304D\u58C1"
    optionRight: "\u4E38\u3044\u5207\u308A\u6B20\u304D\u58C1"
    optionLeftImage: {fileID: -2946482280569149307, guid: 1b6df881714f04426a70bbbd98401b04, type: 3}
    optionRightImage: {fileID: 7653729203682275264, guid: d8212ece1ef244a2d8abe807780e2ee9, type: 3}
    isLeftCorrect: 0
  - navigationText: "\u8D64\u30EC\u30F3\u30AC\u5EFA\u7269\u5317\u5074\u306E\u5916\u58C1\u3092\u898B\u306B\u3044\u3053\u3046\uFF01"
    mapSprite: {fileID: 298339676780788430, guid: 863ff4104b7d44aea9c164c22c387e3c, type: 3}
    questionText: "\u8D64\u30EC\u30F3\u30AC\u5EFA\u7269\u5317\u5074\u306E\u5916\u58C1\u306B\u4ECA\u3082\u6B8B\u3063\u3066\u3044\u308B\u3001\u7B2C\u4E8C\u6B21\u4E16\u754C\u5927\u6226\u306E\u50B7\u8DE1\u3068\u306F\u4F55\uFF1F"
    optionLeft: "\u706B\u707D\u306B\u3088\u308B\u8D64\u30EC\u30F3\u30AC\u306E\u9ED2\u305A\u307F"
    optionRight: "\u6A5F\u9283\u6383\u5C04\u306B\u3088\u308B\u5F3E\u75D5"
    optionLeftImage: {fileID: 1360752240368572825, guid: 3820fca46c2c141568eb263b2ac29e6d, type: 3}
    optionRightImage: {fileID: 6124340699276207153, guid: 1cb5de8c4285547478308108e9887deb, type: 3}
    isLeftCorrect: 0
  questionsEnglish:
  - navigationText: Let's take a look at the red brick from the outside!
    mapSprite: {fileID: 7629668518932357394, guid: 25bc532367b344f4897c35ddd7b7ea28, type: 3}
    questionText: "What is the distinctive structure\u2014a combination of wooden
      framing and brick\u2014that can be seen on the southeast wall of the red brick
      building?"
    optionLeft: Half-timbered structure
    optionRight: Masonry construction
    optionLeftImage: {fileID: 5017201974510294690, guid: d107d599097074bf89d63b63248de70a, type: 3}
    optionRightImage: {fileID: -4131641259849213738, guid: a5bcb4dec10184137955c67b053ec1c4, type: 3}
    isLeftCorrect: 1
  - navigationText: "Let\u2019s look for the stairs along the long hallway!"
    mapSprite: {fileID: -1969723965258880426, guid: 4878ca3cfb6c74e4ea91a41da1d163b6, type: 3}
    questionText: "What were the stairs\u2014which lead all the way to the top floor
      of the five-story tower that has stood since the building\u2019s construction\u2014made
      of?"
    optionLeft: Brick stairs
    optionRight: 'Wooden stairs '
    optionLeftImage: {fileID: -831103238611958488, guid: 555b8feb7998b40e3ab44591ac07e29f, type: 3}
    optionRightImage: {fileID: -7746288438476101081, guid: 70f18a05e154746b1959ff087126d349, type: 3}
    isLeftCorrect: 0
  - navigationText: "Let\u2019s look up at the ceiling of the passageway!"
    mapSprite: {fileID: -99259536455903762, guid: c8c63141ee5d94297af79343d0e550db, type: 3}
    questionText: Which structural design was used for the floor to provide high
      seismic resistance, fire resistance, and thermal insulation?
    optionLeft: Arched fire-resistant floor
    optionRight: 'Lattice-type fire-resistant floor '
    optionLeftImage: {fileID: 6318451787307836473, guid: 010b3089481574d99b69b4d0f1ae303c, type: 3}
    optionRightImage: {fileID: 447541596860047045, guid: 3446a01f758144a70984d1f5c4358a1a, type: 3}
    isLeftCorrect: 1
  - navigationText: "Let\u2019s take a closer look at the walls of the passageway!"
    mapSprite: {fileID: -3954400287755740025, guid: 10f6de352a10b4c738e1f816090a8a07, type: 3}
    questionText: Which design feature was incorporated into the interior walls of
      the passageway to ensure the beer barrels fit snugly?
    optionLeft: 'Square recessed walls '
    optionRight: Round recessed walls
    optionLeftImage: {fileID: -2946482280569149307, guid: 1b6df881714f04426a70bbbd98401b04, type: 3}
    optionRightImage: {fileID: 7653729203682275264, guid: d8212ece1ef244a2d8abe807780e2ee9, type: 3}
    isLeftCorrect: 0
  - navigationText: "Let\u2019s go take a look at the north exterior wall of the
      red-brick building!"
    mapSprite: {fileID: 298339676780788430, guid: 863ff4104b7d44aea9c164c22c387e3c, type: 3}
    questionText: What are the scars from World War II that still remain on the north
      exterior wall of the red-brick building?
    optionLeft: 'Blackening of the red bricks caused by fire '
    optionRight: Bullet holes from machine-gun fire
    optionLeftImage: {fileID: 1360752240368572825, guid: 3820fca46c2c141568eb263b2ac29e6d, type: 3}
    optionRightImage: {fileID: 6124340699276207153, guid: 1cb5de8c4285547478308108e9887deb, type: 3}
    isLeftCorrect: 0
  inputThreshold: 0.3
  resetThreshold: 0.15
